# user-токен VK из-под официального приложения (обычные токены не имеют доступа к messages.*) — тот же, что у бота
VK_TOKEN=
# пароль панели (вводится один раз в форме входа), не короче 20 случайных символов
WEB_PASSWORD=
# адрес панели: IP сервера или домен; Caddy выпускает самоподписанный сертификат (tls internal),
# браузер один раз попросит подтвердить исключение. Нужен открытый порт 443
WEB_DOMAIN=
# зона для дат в мессенджере и для «сейчас» в пробных прогонах
# WEB_TIMEZONE=Europe/Moscow

# где лежат данные бота vk-mcp (читает docker compose): его config/ — панель их правит,
# volume со state/ — панель только читает, сеть — в ней виден сервис ai
BOT_CONFIG_DIR=/path/to/vk_mcp/config
BOT_STATE_VOLUME=vk_mcp_state
BOT_NETWORK=vk_mcp_default

# ИИ-сервис бота в общей сети; пусто — LLM работает внутри панели, тогда нужны ключи провайдеров ниже
AI_URL=http://ai:8090
# AI_TIMEOUT_SECONDS=200
# LLM_PROVIDER=grok
# LLM_API_KEY=
# XAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=

# потолки агента: показаны на странице «Настройки» и действуют в песочнице; держи их равными .env бота
# AGENT_MAX_STEPS=16
# AGENT_TIME_BUDGET_SECONDS=240
# AGENT_RESULT_CHAR_LIMIT=12000
# AGENT_CONFIRM_TTL_SECONDS=300
# USER_COOLDOWN_SECONDS=2
# CHAT_LIMIT_PER_HOUR=60
# GLOBAL_LIMIT_PER_MINUTE=30
# LLM_TEMPERATURE=0.8

# пути к данным бота при запуске без Docker (в контейнере это /app/config и /app/state)
# ACCESS_FILE=config/access.json
# RUNTIME_FILE=config/runtime.json
# PERSONAS_DIR=config/personas
# STATE_DIR=state
