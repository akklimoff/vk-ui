# user-токен VK из-под официального приложения (обычные токены не имеют доступа к messages.*)
VK_TOKEN=
# пароль панели (вводится один раз в форме входа), не короче 20 случайных символов
WEB_PASSWORD=
# адрес панели: IP сервера или домен; Caddy выпускает самоподписанный сертификат (tls internal),
# браузер один раз попросит подтвердить исключение. Панель — https://<WEB_DOMAIN>:8080, порт 8080 должен быть открыт
WEB_DOMAIN=
# часовой пояс для дат в мессенджере
# WEB_TIMEZONE=Europe/Moscow
