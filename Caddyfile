{
	# по голому IP клиенты не шлют SNI, без этого Caddy не находит сертификат
	default_sni {$WEB_DOMAIN}
	# наружу открыт только 8080: редиректу с порта 80 некуда вести
	auto_https disable_redirects
	# опубликован только TCP 8080: объявленный HTTP/3 по UDP браузер пробовал бы впустую
	servers {
		protocols h1 h2
	}
}

{$WEB_DOMAIN}:8080 {
	tls internal
	# без text/event-stream: сжатие копит поток событий в буфере, и сигнал о новом сообщении опаздывал бы
	encode zstd gzip {
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type image/svg+xml*
		}
	}
	reverse_proxy web:8080
	# свой Cache-Control панели (файлы VK, поток событий) не перетирается
	header ?Cache-Control "no-store"
	# адрес статики содержит хеш файла: новая выкладка — новый адрес, старый можно хранить вечно
	@static path /static/*
	header @static Cache-Control "public, max-age=31536000, immutable"
}
